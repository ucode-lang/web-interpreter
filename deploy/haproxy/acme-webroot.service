[Unit]
Description=Loopback static file server for ACME challenge (haproxy routes only /.well-known/acme-challenge here)
After=network.target

[Service]
ExecStart=/usr/bin/python3 -m http.server 8081 --bind 127.0.0.1 --directory /var/www/acme
Restart=always
User=root

[Install]
WantedBy=multi-user.target
