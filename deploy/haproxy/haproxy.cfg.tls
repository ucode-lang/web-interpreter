global
    log 127.0.0.1:514 local0
    maxconn 4096

defaults
    mode http
    log global
    option httplog
    timeout connect 5s
    timeout client 30s
    timeout server 30s
    timeout tunnel 3600s

frontend http
    bind *:80
    acl is_acme path_beg /.well-known/acme-challenge
    http-request set-header X-Forwarded-Proto https
    http-request redirect scheme https code 301 unless is_acme
    use_backend acme if is_acme
    default_backend ucodepen

frontend https
    # one <domain>.pem + <domain>.pem.key pair per domain, SNI-selected
    bind *:443 ssl crt /etc/certificates
    http-request set-header X-Forwarded-Proto https
    default_backend ucodepen

backend acme
    server acme 127.0.0.1:8081

backend ucodepen
    server ucodepen 127.0.0.1:8000
