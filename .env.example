# ucodepen deployment settings -- copy to .env and fill in.
#
#   cp .env.example .env
#   docker compose up -d --build

# --- required ---------------------------------------------------------------

# database password the app uses against the postgres container
POSTGRES_PASSWORD=change-me

# --- login (leave empty for local mode: no login, one shared store) ---------
#
# 1. register an OAuth App under your personal account:
#       https://github.com/settings/applications/new
#    (GitHub removed organisation-owned OAuth apps; the app's owner does not
#    matter -- any GitHub user can authorise it, and GITHUB_ORG below is what
#    restricts who may sign in)
#    - Homepage URL:            https://run.ucode-lang.org
#    - Authorization callback:  https://run.ucode-lang.org/api/auth/callback
# 2. fill in the client id and secret here.
#
# With GITHUB_ORG set, only members of that organisation can sign in
# (e.g. GITHUB_ORG=ucode-lang). Empty means any GitHub account.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ORG=

# --- optional ---------------------------------------------------------------

# session signing key; a fresh random one is generated per container start
# when empty, which logs everybody out on restart. Set one in production:
#   openssl rand -hex 32
SECRET_KEY=

# host port to publish the app on
PORT=8000

# public origin, only needed behind a proxy that rewrites the Host header
# (the OAuth callback URL is derived from it)
# BASE_URL=https://run.ucode-lang.org